# Maintainer: Roflochinsky <https://github.com/Roflochinsky>
#
# Arch Linux / Omarchy package. Builds the tagged release from source against
# the system WebKitGTK. From a checkout, `./build-local.sh` packs the working
# tree as that release tarball first.

pkgname=tgsum
pkgver=0.2.0
pkgrel=1
pkgdesc='Turn a Telegram Desktop export (result.json) into clean Markdown for AI chats'
arch=('x86_64' 'aarch64')
url='https://github.com/Roflochinsky/tgsum'
license=('MIT')
depends=('cairo' 'gcc-libs' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme'
         'libsoup3' 'pango' 'webkit2gtk-4.1' 'xdg-utils')
makedepends=('cargo')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # the release workflow and build-local.sh build from the tag/checkout

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p tgsum
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen -p tgsum-core
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/tgsum -t "$pkgdir/usr/bin"
  install -Dm644 src-tauri/tgsum.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 src-tauri/icons/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/tgsum.svg"
  local size
  for size in 32 64 128; do
    install -Dm644 "src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/tgsum.png"
  done
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/tgsum.png"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/tgsum.png"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
